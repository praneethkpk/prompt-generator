# ─────────────────────────────────────────────────────────────
# PromptGen Backend — Environment Variables (Spring Boot)
# ─────────────────────────────────────────────────────────────

# Server Port (default 8080)
PORT=8080

# JWT Authentication
# Generate a cryptographically secure 256-bit string (min 32 chars)
JWT_SECRET=DevOnlySecretKeyThatMustBeReplacedInProduction2026!
JWT_ACCESS_EXPIRY=900000        # 15 minutes in ms
JWT_REFRESH_EXPIRY=604800000    # 7 days in ms

# AES-256-GCM Master Encryption Key for storing BYOK API Keys in the vault
# Must be a 32-byte Base64-encoded key. Generate one with:
# openssl rand -base64 32
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production Database (PostgreSQL) - Not needed for H2 development profile
DB_HOST=localhost
DB_PORT=5432
DB_NAME=promptgen_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
