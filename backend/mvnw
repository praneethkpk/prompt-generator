#!/bin/sh
# Maven Wrapper startup script for UN*X systems

set -e

# Find project base directory
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
export MAVEN_PROJECTBASEDIR

# Maven wrapper JAR location
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Download Maven wrapper if it doesn't exist
if [ ! -e "$WRAPPER_JAR" ]; then
    if command -v wget > /dev/null; then
        WRAPPER_URL=$(grep "wrapperUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
        wget "$WRAPPER_URL" -O "$WRAPPER_JAR"
    elif command -v curl > /dev/null; then
        WRAPPER_URL=$(grep "wrapperUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
        curl -sL "$WRAPPER_URL" -o "$WRAPPER_JAR"
    else
        echo "Error: Neither wget nor curl found. Please install one or download maven-wrapper.jar manually."
        exit 1
    fi
fi

# Execute Maven
exec java $MAVEN_OPTS \
    -classpath "$WRAPPER_JAR" \
    org.apache.maven.wrapper.MavenWrapperMain "$@"
