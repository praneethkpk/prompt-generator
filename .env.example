# ─────────────────────────────────────────────────────────────
# Prompt Generator — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# 🔒 SECURITY: Variables WITHOUT the VITE_ prefix are SERVER-ONLY.
#    They are NEVER exposed to the browser bundle.
#
# The backend proxy uses the OpenAI-compatible chat completions
# API, so you can point it at ANY provider that speaks the same
# protocol — just change the URL and model below.
# ─────────────────────────────────────────────────────────────

# Required — your API key (server-side only, never sent to browser)
LLM_API_KEY=your-api-key-here

# Optional — override the base URL (defaults to OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
#
# Provider examples:
#   Groq      → https://api.groq.com/openai/v1
#   DeepSeek  → https://api.deepseek.com/v1
#   Ollama    → http://localhost:11434/v1
#   Gemini    → https://generativelanguage.googleapis.com/v1beta/openai/

# Optional — override the model (defaults to gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
#
# Model examples:
#   Groq      → llama-3.3-70b-versatile
#   DeepSeek  → deepseek-chat
#   Ollama    → llama3
#   Gemini    → gemini-3.5-flash

# Optional — backend server port (defaults to 3001)
# PORT=3001
